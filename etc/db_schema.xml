<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="tonyapps_email_design" resource="default" engine="innodb" comment="Email Designer Designs">
        <column xsi:type="int" name="design_id" unsigned="true" nullable="false" identity="true" comment="Design ID"/>
        <column xsi:type="int" name="template_id" unsigned="true" nullable="false" comment="Core Email Template ID"/>
        <column xsi:type="varchar" name="base_template_code" length="200" nullable="false" comment="Email The Design Is For"/>
        <column xsi:type="mediumtext" name="project_data" nullable="false" comment="GrapesJS Project JSON"/>
        <column xsi:type="mediumtext" name="mjml" nullable="false" comment="MJML Source"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY"><column name="design_id"/></constraint>
        <constraint xsi:type="unique" referenceId="TONYAPPS_EMAIL_DESIGN_TEMPLATE_ID"><column name="template_id"/></constraint>
        <constraint xsi:type="foreign" referenceId="TONYAPPS_EMAIL_DESIGN_TEMPLATE_ID_EMAIL_TEMPLATE_TEMPLATE_ID"
                    table="tonyapps_email_design" column="template_id" referenceTable="email_template"
                    referenceColumn="template_id" onDelete="CASCADE"/>
    </table>
    <table name="tonyapps_email_design_version" resource="default" engine="innodb" comment="Email Designer Saved Versions">
        <column xsi:type="int" name="version_id" unsigned="true" nullable="false" identity="true" comment="Version ID"/>
        <column xsi:type="int" name="design_id" unsigned="true" nullable="false" comment="Design ID"/>
        <column xsi:type="mediumtext" name="project_data" nullable="false" comment="GrapesJS Project JSON"/>
        <column xsi:type="mediumtext" name="mjml" nullable="false" comment="MJML Source"/>
        <column xsi:type="mediumtext" name="html" nullable="false" comment="Compiled HTML"/>
        <column xsi:type="varchar" name="subject" length="200" nullable="true" comment="Subject"/>
        <column xsi:type="int" name="admin_user_id" unsigned="true" nullable="true" comment="Saved By"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Saved At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY"><column name="version_id"/></constraint>
        <constraint xsi:type="foreign" referenceId="TONYAPPS_EMAIL_DESIGN_VERSION_DESIGN_ID_TONYAPPS_EMAIL_DESIGN_DESIGN_ID"
                    table="tonyapps_email_design_version" column="design_id" referenceTable="tonyapps_email_design"
                    referenceColumn="design_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="TONYAPPS_EMAIL_DESIGN_VERSION_ADMIN_USER_ID_ADMIN_USER_USER_ID"
                    table="tonyapps_email_design_version" column="admin_user_id" referenceTable="admin_user"
                    referenceColumn="user_id" onDelete="SET NULL"/>
        <index referenceId="TONYAPPS_EMAIL_DESIGN_VERSION_DESIGN_ID" indexType="btree"><column name="design_id"/></index>
    </table>
</schema>
